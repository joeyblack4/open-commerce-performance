{
  "name": "black4-open-commerce-performance-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:core && npm run test:ui",
    "demo": "PYTHONPATH=src uv run python -m ocp.server",
    "audit:protocols": "./scripts/protocol_audit",
    "evaluate": "PYTHONPATH=src uv run python scripts/evaluate.py",
    "test:ui": "vitest run",
    "test:core": "PYTHONPATH=src uv run python -m unittest discover -s tests -v",
    "package:review": "uv run python scripts/package_release.py"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
