{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental portable business claim 0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "claim_id",
    "subject",
    "issuer",
    "method",
    "population",
    "result",
    "assurance",
    "observed_at",
    "issued_at",
    "expires_at",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "relationship"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "service",
        "eligibility",
        "exclusions",
        "eligible_count",
        "observed_count",
        "missing_count"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "eligibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "exclusions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "aggregation",
        "state"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "aggregation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "state": {
          "enum": [
            "observed",
            "unknown"
          ]
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_name",
        "provider_endorsed",
        "checks",
        "source_accuracy",
        "independent_audit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_provider_issued",
            "service_calculated",
            "business_asserted"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "provider_endorsed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "source_accuracy": {
          "enum": [
            "not_established",
            "corroborated"
          ]
        },
        "independent_audit": {
          "type": "boolean"
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
